# ==========================================================
# AI IT Support & Helpdesk System - Environment Variables Template
# Copy this file to .env and configure your production values
# ==========================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL Production Mode)
DB_URL=jdbc:mysql://localhost:3306/it_helpdesk_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password

# Default Initial Administrator Account (Change before production deployment!)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@helpdesk.com
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_DEPT=IT Operations

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
